<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 项目配置（pom.xml）—— Java 世界的 package.json
  ====================================================
  对比学习（Node 版 package.json → Maven pom.xml）：
    - <parent> 声明继承 Spring Boot 官方父工程：类似"依赖了一个官方维护的版本管家"，
      内含 300+ 常用依赖的版本号（BOM），子项目引依赖时无需写 <version>，也保证版本互相兼容
    - <dependencies> 对应 package.json 的 dependencies
    - <build>/<plugins> 对应 package.json 的 scripts（如 spring-boot-maven-plugin 提供
      mvn spring-boot:run ≈ npm run dev；打包出的可执行 jar ≈ node 直接跑入口文件）
    - mvn 命令无需 install：Maven 自己去远程仓库下载依赖并缓存到 ~/.m2（类似 node_modules，
      但按"全局仓库"缓存、各项目共享，不会在项目里塞一个 node_modules 目录）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/> <!-- 不从本地路径找父 pom，而是从仓库下载 -->
  </parent>

  <!-- 项目坐标：groupId.包名 定位项目，类似 npm 包名 + 版本 -->
  <groupId>com.aimodel.compare</groupId>
  <artifactId>model-compare-server-java</artifactId>
  <version>0.1.0</version>
  <name>model-compare-server-java</name>
  <description>AI 模型比价后端 - Java 版（Spring Boot + MyBatis + SQLite），与 Node 版功能一致</description>

  <properties>
    <!-- 编译目标 JDK 版本：Spring Boot 3.x 最低要求 Java 17，本项目用 21（当前 LTS） -->
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!--
      Web 起步依赖 ≈ express + 中间件生态。
      "starter" 是 Spring Boot 的依赖打包概念：一个 starter 聚合了一类场景所需的全部依赖
      （这里包含内嵌 Tomcat、Spring MVC、Jackson JSON 序列化等）。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      MyBatis 官方的 Spring Boot 适配包：
        - 引入 mybatis 核心（SQL 映射框架，对标 Node 版手写 dao 的那一层）
        - 引入 spring-boot-starter-jdbc（含 HikariCP 连接池 + DataSourceTransactionManager，
          使 @Transactional 注解开箱可用 ≈ better-sqlite3 的 db.transaction()）
      注意：3.0.x 系列才兼容 Spring Boot 3（jakarta 命名空间）；2.x 只兼容 Boot 2。
    -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!--
      SQLite 的纯 Java JDBC 驱动（xerial 出品）≈ better-sqlite3。
      区别：JDBC 是 Java 标准数据库接口，所有数据库驱动都实现同一套接口，切换数据库只需换依赖和 URL。
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot 打包/运行插件：提供 mvn spring-boot:run（开发热启动）与打"可执行 fat jar"能力 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
